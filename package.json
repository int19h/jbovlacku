{
  "name": "jbovlacku-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:core": "bash scripts/build-core.sh",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "test:service": "tsx --test packages/service/test/*.test.ts",
    "start": "tsx apps/server/src/main.ts",
    "build:web": "vite build --config apps/web/vite.config.ts && node scripts/copy-notices.mjs web",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "test:web-unit": "tsx --test apps/web/test/unit/*.test.ts",
    "test:web": "playwright test --config apps/web/playwright.config.ts",
    "build:server": "esbuild apps/server/src/main.ts apps/server/src/evaluation-worker.ts apps/server/src/semantic-worker.ts apps/server/src/pattern-search-worker.ts --bundle --platform=node --format=esm --target=node24 --outdir=apps/server/dist && node scripts/copy-notices.mjs server",
    "build": "npm run build:morphology && npm run build:core && npm run build:server && npm run build:web",
    "start:built": "node apps/server/dist/main.js",
    "test:adapters": "tsx scripts/test-adapters.ts",
    "build:morphology": "node scripts/build-morphology.mjs",
    "test:morphology": "node scripts/build-morphology.mjs --check && tsx --test packages/morphology/test/*.test.ts",
    "test:search": "tsx --test packages/search/test/*.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "esbuild": "0.28.1",
    "jose": "6.1.3",
    "peggy": "5.1.1",
    "prettier": "3.7.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "dependencies": {
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.8"
  }
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jbovlacku-local-prototype",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "jbovlacku-local-objects",
      "remote": false,
    },
  ],
  "d1_databases": [
    {
      "binding": "INDEX",
      "database_name": "jbovlacku-local-index",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "remote": false,
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "COORDINATOR", "class_name": "AdmissionCoordinator" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AdmissionCoordinator"] },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "secrets": { "required": ["JVC_AI_KEY"] },
  "vars": {
    "SERVER_ID": "local-worker",
    "SELECTED_VIEW": "",
    "PUBLIC_ORIGIN": "",
    "PROTOTYPE_BATCH": "disabled",
    "SNAPSHOT_LIMIT": "16",
    "JVC_AI_ENABLED": "disabled",
    "JVC_AI_BASE_URL": "https://openrouter.ai/api/v1",
    "JVC_AI_MODEL": "meta/muse-spark-1.3-contributor",
    "JVC_AI_PROVIDER_ROUTE": "meta",
    "JVC_AI_PROVIDER_NAME": "OpenRouter",
    "JVC_AI_REASONING_EFFORT": "medium",
    "JVC_AI_DECISION_REPORTS": "disabled",
    "JVC_AI_MAX_TOKENS": "16384",
    "JVC_AI_TIMEOUT_MS": "120000",
    "JVC_AI_CONCURRENCY": "2",
    "JVC_AI_MAX_COST_USD": "2",
    "JVC_AI_MAX_PRICE": "10",
    "JVC_AI_OPERATIONS": "type,lujvo,gismu-sources,cmavo-class,definition,places-glosses",
  },
}
